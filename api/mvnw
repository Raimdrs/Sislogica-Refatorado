#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Start Up Batch script
# ----------------------------------------------------------------------------

export MAVEN_PROJECTBASEDIR=${MAVEN_BASEDIR:-"$PWD"}

MVN_CMD="mvn"
if command -v "$MVN_CMD" >/dev/null 2>&1; then
    exec "$MVN_CMD" "$@"
fi

# Fallback: download maven-wrapper.jar if needed
WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
if [ ! -f "$WRAPPER_JAR" ]; then
    mkdir -p .mvn/wrapper
    curl -sLo "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar || wget -qO "$WRAPPER_JAR" https://repo.maven.apache.org/maven2/org/apache/maven/wrapper/maven-wrapper/3.2.0/maven-wrapper-3.2.0.jar
fi

exec java -jar "$WRAPPER_JAR" "$@"
