# ==========================================
# Configurações do Banco de Dados PostgreSQL
# Copie este arquivo para .env na raiz e em api/.env
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sislogica_db
DB_USER=sislogica_user
DB_PASSWORD=sislogica_password
DB_URL=jdbc:postgresql://localhost:5432/sislogica_db

# Variáveis utilizadas pelo container PostgreSQL (docker-compose.yml)
POSTGRES_DB=sislogica_db
POSTGRES_USER=sislogica_user
POSTGRES_PASSWORD=sislogica_password
POSTGRES_PORT=5432
